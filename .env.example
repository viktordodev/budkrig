# ─────────────────────────────────────────────────────────────────────────────
# Budkrig — environment variables
# Copy to .env for local dev. In preview/production these are set in Coolify's
# per-service encrypted config. NEVER commit a filled-in .env.
# Every key here is parsed + validated by src/server/config/env.ts (Zod).
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local                      # local | preview | production
APP_URL=http://localhost:3000      # public base URL, no trailing slash
PORT=3000
HOSTNAME=0.0.0.0

# --- Database (Postgres) ---------------------------------------------------
# App runs as a least-privilege role; migrations use a separate role (ADR-0003).
DATABASE_URL=postgres://budkrig_app:app@localhost:5432/budkrig
DATABASE_MIGRATION_URL=postgres://budkrig_migrator:migrate@localhost:5432/budkrig
DATABASE_POOL_MAX=10               # keep low so a spike can't exhaust Postgres (N4)

# --- Redis (cache + BullMQ queue + rate limiting) ------------------------
REDIS_URL=redis://localhost:6379

# --- Stripe (ADR-0006 / ADR-0007) ---------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx # only if we ever add Elements; unused for hosted Checkout
STRIPE_TAX_ENABLED=true

# --- Payments / product rules (ADR-0004 / ADR-0005) --------------------
CURRENCY=SEK
NEW_LISTING_MIN_ORE=500            # 5.00 kr to start a listing (Open question Q7)
MIN_INCREMENT_ORE=100             # +1.00 kr minimum raise (Open question Q3)
PENDING_BID_TTL_MINUTES=30
TIMEZONE=Europe/Stockholm

# --- Listing management magic links (ADR-0008) ------------------------
LISTING_MANAGEMENT_JWT_SECRET=change-me-32-bytes-min
MANAGE_LINK_TTL_HOURS=24
IP_HASH_SALT=change-me-random

# --- Email (receipts, invoices, manage links) -------------------------
EMAIL_PROVIDER=resend              # resend | postmark | smtp
EMAIL_FROM="Budkrig <no-reply@budkrig.se>"
RESEND_API_KEY=
# local dev catches mail in Mailpit:
SMTP_URL=smtp://localhost:1025

# --- Object storage (OG images + encrypted offsite backups) ----------
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=budkrig
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Moderation (ADR-0012) -------------------------------------------
SAFE_BROWSING_API_KEY=

# --- Observability (ADR-0013) ---------------------------------------
LOG_LEVEL=debug                    # debug | info | warn | error
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PLAUSIBLE_DOMAIN=

# --- Operator area gate --------------------------------------------
OPERATOR_ALLOWED_EMAILS=you@example.com
