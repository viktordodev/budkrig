{
  "name": "budkrig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:worker && node scripts/prep-standalone.mjs",
    "build:worker": "tsup",
    "start": "node .next/standalone/server.js",
    "worker": "node dist/workers/main.js",
    "worker:dev": "node --env-file-if-exists=.env --watch --import tsx src/workers/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/server/db/seed.ts",
    "infra:up": "docker compose -f docker/compose.yaml up -d",
    "infra:down": "docker compose -f docker/compose.yaml down",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "next": "^15.5.0",
    "next-intl": "^3.25.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "fast-check": "^3.23.0",
    "lefthook": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^10.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  }
}
