{
  "name": "budkrig",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:worker",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "next start",
    "worker": "node dist/workers/main.js",
    "worker:dev": "tsx watch src/workers/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/server/db/seed.ts",
    "infra:up": "docker compose -f docker/compose.yaml up -d",
    "infra:down": "docker compose -f docker/compose.yaml down",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.0",
    "stripe": "^18.0.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "next-intl": "^3.25.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "fast-check": "^3.23.0",
    "lefthook": "^1.8.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
